$footer-extra-link-gap = 20px

.footer
  background: transparent
  color: $text-1-color
  padding: rem(0 0 30px)

// Floating rounded card: the whole footer is one white card on the warm page.
.footer__card
  background: #FFF
  border: 1px solid #EDE2C6
  border-top: 2px solid $secondary-color
  border-radius: rem(16px)
  box-shadow: 0 10px 30px rgba(#B89B5E, 0.16)
  padding: rem(28px 28px 6px)

  +mobile()
    border-radius: rem(12px)
    margin: 0 rem($grid-padding)
    padding: rem($grid-padding)
    box-shadow: 0 6px 18px rgba(#B89B5E, 0.12)

.footer__brand
  display: flex
  align-items: center
  gap: rem(14px)
  padding-bottom: rem(18px)
  margin-bottom: rem(18px)
  border-bottom: 1px solid #EFE6CE

  +mobile()
    align-items: flex-start
    margin-bottom: rem(12px)
    padding-bottom: rem(12px)

.footer__brand-badge
  width: rem(52px)
  height: rem(52px)
  border-radius: 50%
  background: #FFF
  box-shadow: 0 0 0 3px #F4E7C3
  object-fit: contain
  flex: none

.footer__brand-text
  h1
    margin: 0
    font-size: rem(20px)
    color: #6B4F0F
    letter-spacing: 0.12em
    font-weight: 700

  p
    margin: rem(4px 0 0)
    font-size: rem($font-size-small)
    color: $text-2-color
    line-height: 1.6

.footer__brand-online
  display: inline-flex
  align-items: center
  gap: rem(7px)
  margin-top: rem(10px)
  padding: rem(3px 12px)
  border-radius: 999px
  background: #F7EFDA
  color: #8A6A12
  font-size: rem(12px)
  font-weight: 500

  b
    color: $primary-color
    font-size: rem(14px)
    font-weight: 700

.online-dot
  width: 8px
  height: 8px
  border-radius: 50%
  background: #35B37E
  box-shadow: 0 0 0 0 rgba(#35B37E, 0.5)
  animation: online-pulse 1.6s ease-out infinite

@keyframes online-pulse
  0%
    box-shadow: 0 0 0 0 rgba(#35B37E, 0.5)
  70%
    box-shadow: 0 0 0 6px rgba(#35B37E, 0)
  100%
    box-shadow: 0 0 0 0 rgba(#35B37E, 0)

.footer__cols
  display: flex
  gap: rem(26px)

  +mobile()
    display: block
    gap: 0

.footer__category
  flex: 1
  min-width: 0
  padding: 0

  h1
    font-size: rem(14px)
    color: #8A6A12
    letter-spacing: 0.06em

    +mobile()
      padding: rem($grid-padding)
      cursor: pointer
      font-size: rem($font-size-secondary)

  +mobile()
    padding: 0
    border-bottom: 1px solid darken(#FFF, 5%)

    &.expandable
      padding: 0

  .expand-icon
    display: none

    +mobile()
      display: inline-block

  &.expanded .expand-icon
    transform: rotate(180deg)

.footer__category__list
  margin-top: rem(10px)
  margin-bottom: rem(10px)
  font-size: rem($font-size-small)
  line-height: 2

  a
    transition: color .2s

    &:hover
      color: $primary-color
      text-decoration: underline
      text-underline-offset: 3px

  +mobile()
    margin-top: 0
    padding-left: rem($grid-padding)
    padding-right: rem($grid-padding)

.footer__category__expander
  +mobile()
    display: none

  +above(rupture.mobile-cutoff)
    display: block !important

.footer__extra-left
  float: left

.footer__extra-right
  float: right

.footer__extra-link
  padding: rem(18px 0 20px)
  margin-top: rem(16px)
  font-size: rem($font-size-small)
  border-top: 1px solid #EFE6CE

.footer__extra-link-item
  float: left
  line-height: 2

.footer__extra-left .footer__extra-link-item
  margin-right: rem($footer-extra-link-gap)

.footer__extra-right .footer__extra-link-item
  margin-left: rem($footer-extra-link-gap)

.layout--immersive
  .footer
    background: none

+mobile()
  .footer__extra-left, .footer__extra-right
    float: none
    display: block

    .footer__extra-link-item
      float: none
      display: inline-block
      margin-left: 0
      margin-right: $footer-extra-link-gap
