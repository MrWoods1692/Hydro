$stripe-width = 3px
$radius = 10px

.messagepad__list-item
  display: block
  padding: rem(14px $section-gap-h 14px ($section-gap-h - $stripe-width))
  border-left: $stripe-width solid transparent
  cursor: pointer
  transition: border-color 0.15s ease, background-color 0.15s ease
  overflow: hidden
  text-overflow: ellipsis
  margin: rem(4px 8px)
  border-radius: rem($radius)

  &:hover
    border-color: #C8C4BC
    background: rgba(247, 247, 245, 0.8)
    text-decoration: none

  &.active
    border-color: #C8C4BC
    background: rgba(240, 239, 235, 0.8)

.messagepad__desc
  font-size: rem($font-size-small)
  color: #9A9690
  max-height: 2em
  margin-top: rem(4px)
  overflow: hidden
  text-overflow: ellipsis
  word-wrap()
